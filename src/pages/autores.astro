---
import { useTranslations } from "../i18n/utils";
const lang = "es";
const t = useTranslations(lang);

import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import SchemaOrg from "../components/SchemaOrg.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SkeletonImageNatural from "../components/SkeletonImageNatural.astro";
import { SITE_TITLE } from "../consts";

const authors = await getCollection("authors");

const siteUrl = Astro.site ? Astro.site.toString() : "https://kanaime.com";

---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      title={`${t("nav.authors")} — ${SITE_TITLE}`}
      description={t("authors.description")}
      lang={lang}
    />
    <SchemaOrg
      schema={{
        type: "website",
        name: `${t("nav.authors")} — ${SITE_TITLE}`,
        description: t("authors.description"),
        url: `${siteUrl}/autores/`,
      }}
    />
    <SchemaOrg
      schema={{
        type: "breadcrumb",
        items: [
          { name: t("nav.home"), url: `/` },
          { name: t("nav.authors"), url: `/autores/` },
        ],
      }}
    />
  </head>
  <body>
    <Header lang={lang} />
    <main class="w-full bg-white">
      <!-- Page Header -->
      <section
        class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-16 md:pt-24 pb-8"
      >
        <p
          class="text-[10px] md:text-xs uppercase tracking-[0.3em] text-gray-400 mb-4"
        >
          {t("authors.subtitle")}
        </p>
        <h1
          class="text-5xl md:text-7xl lg:text-8xl font-bold leading-none mb-6"
          style="font-family: 'Bebas Neue', sans-serif;"
        >
          {t("authors.title")}
        </h1>
        <p
          class="text-lg md:text-xl font-light text-gray-600 max-w-2xl leading-relaxed"
          style="font-family: 'Source Serif 4', serif;"
        >
          {t("authors.description")}
        </p>
      </section>

      <!-- Authors Grid -->
      <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pb-20 md:pb-32">
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16 md:gap-y-24"
        >
          {
            authors.map((author) => {
              if (author.data.name == "Kanaimé Editorial") {
                return;
              }
              const photoSrc =
                author.data.photo && typeof author.data.photo === "object"
                  ? author.data.photo.src
                  : author.data.photo;
              return (
                <article class="group">
                  <a href={`/autor/${author.id}/`} class="block">
                    <div class="overflow-hidden mb-6 bg-gray-100">
                      {photoSrc ? (
                        <SkeletonImageNatural
                          src={photoSrc}
                          alt={author.data.name}
                          class="w-full"
                          imgClass="w-full h-auto grayscale group-hover:grayscale-0 transition-all duration-500 group-hover:scale-105"
                        />
                      ) : (
                        <div class="w-full aspect-[3/4] flex items-center justify-center bg-gray-200 text-gray-400">
                          <span
                            class="text-4xl font-bold"
                            style="font-family: 'Bebas Neue', sans-serif;"
                          >
                            {author.data.name.charAt(0)}
                          </span>
                        </div>
                      )}
                    </div>
                  </a>
                  <div class="flex items-baseline justify-between mb-2">
                    <h2
                      class="text-2xl md:text-3xl font-bold"
                      style="font-family: 'Bebas Neue', sans-serif;"
                    >
                      <a
                        href={`/autor/${author.id}/`}
                        class="hover:text-[#A31621] transition-colors"
                      >
                        {author.data.name}
                      </a>
                    </h2>
                  </div>
                  <span class="text-[10px] uppercase tracking-wider text-gray-400 border border-gray-200 px-2 py-1">
                    {author.data.role}
                  </span>
                  <p
                    class="text-sm md:text-base font-light text-gray-600 leading-relaxed line-clamp-3 mt-2"
                    style="font-family: 'Source Serif 4', serif;"
                  >
                    {author.data.bio}
                  </p>
                </article>
              );
            })
          }
        </div>
      </section>
    </main>
    <Footer lang={lang} />
  </body>
</html>
