---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SchemaOrg from "../components/SchemaOrg.astro";
import MainPost from "../components/MainPost.astro";
import HomeBody from "../components/HomeBody.astro";
import Divider from "../components/Divider.astro";
import Sidebar from "../components/sidebar/Sidebar.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import { useTranslations } from "../i18n/utils";
import { SITE_TITLE, SITE_DESCRIPTION, COVER_BG_COLOR } from "../consts";
import { getImageSrc } from "../utils/images";

const lang = "es";
const t = useTranslations(lang);

const posts = (await getCollection("blog"))
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = posts[0];
const featuredImageSrc = getImageSrc(featuredPost?.data.heroImage);
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  image={featuredPost?.data.heroImage}
  lang={lang}
  alternates={{ es: "/", en: "/en/" }}
>
  <Fragment slot="head">
    <SchemaOrg
      schema={{
        type: "website",
        name: SITE_TITLE,
        description: SITE_DESCRIPTION,
        url: `${Astro.site}/`,
        searchUrl: `${Astro.site}/search/?q={search_term_string}`,
      }}
    />
    <SchemaOrg
      schema={{
        type: "breadcrumb",
        items: [{ name: t("nav.home"), url: `/` }],
      }}
    />
    <style>
      #hero-cover {
        background-color: var(--cover-color, #a31621);
        transition:
          opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
          transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
      }
      #hero-cover.hidden {
        opacity: 0;
        pointer-events: none;
        transform: scale(0.98);
      }
      body.hero-open {
        overflow: hidden;
      }
      body.hero-open #main-content {
        opacity: 0;
        pointer-events: none;
      }
    </style>
    <noscript>
      <style>
        #hero-cover { display: none !important; }
        #main-content { opacity: 1 !important; pointer-events: auto !important; }
        body { overflow: auto !important; }
        #show-cover-btn { display: none !important; }
      </style>
    </noscript>
    <script src="/scripts/hero-cover.js" is:inline></script>
  </Fragment>

  <!-- HERO MODAL: Portada del día -->
  <section
    id="hero-cover"
    class="fixed inset-0 z-50 flex flex-col items-center justify-center px-6 py-10"
    style={`--cover-color: ${COVER_BG_COLOR};`}
    aria-label={t("hero.show")}
  >
    <button
      id="hero-close"
      class="absolute top-6 right-6 md:top-10 md:right-10 text-white text-4xl md:text-6xl font-light hover:scale-110 transition-transform z-50 cursor-pointer"
      aria-label={t("hero.close")}
    >
      &times;
    </button>

    <div
      id="hero-logo"
      class="absolute top-4 left-1/2 -translate-x-1/2 md:top-8 text-white text-6xl md:text-8xl lg:text-9xl font-bold bebas-neue-regular tracking-wider z-10"
    >
      {SITE_TITLE}
    </div>

    <div
      class="flex flex-col items-center justify-center text-center max-w-4xl w-full mt-28 md:mt-36 cursor-pointer"
      id="hero-content"
    >
      {featuredImageSrc && (
        <div class="w-full max-w-md md:max-w-xl lg:max-w-2xl px-4">
          <img
            src={featuredImageSrc}
            alt={featuredPost.data.title}
            class="w-full h-auto object-cover shadow-2xl"
          />
        </div>
      )}

      <h1 class="text-white text-3xl md:text-5xl lg:text-7xl font-bold mt-6 md:mt-10 leading-tight px-4">
        {featuredPost.data.title}
      </h1>

      <p class="text-white/80 text-xs md:text-sm mt-6 md:mt-8 uppercase tracking-widest">
        {t("hero.cta")}
      </p>
    </div>
  </section>

  <!-- MAIN CONTENT: Blog -->
  <div id="main-content">
    <main class="grid grid-cols-1 md:grid-cols-12">
      <div class="col-span-1 md:col-span-12">
        <MainPost
          postId={featuredPost.id}
          imgUrl={featuredImageSrc}
          imgAlt={featuredPost.data.title}
          title={featuredPost.data.title}
          description={featuredPost.data.description}
          author={featuredPost.data.author}
          pubDate={featuredPost.data.pubDate}
          tags={featuredPost.data.tags}
          lang={lang}
        />
        <Divider className="my-12 md:my-[100px]" />
      </div>

      <section class="col-span-1 md:col-span-8 lg:col-span-9">
        <HomeBody posts={posts} lang={lang} />
        <NewsletterSignup lang={lang} />
      </section>

      <section class="col-span-1 md:col-span-4 lg:col-span-3 p-4 md:p-5">
        <Sidebar
          lang={lang}
          mode="detail"
          widgets={["featured", "tags", "authors", "random", "archive"]}
          posts={posts}
        />
      </section>
    </main>
  </div>

  <!-- BOTÓN MOSTRAR PORTADA -->
  <button
    id="show-cover-btn"
    class="fixed bottom-6 right-6 z-40 bg-black text-white px-5 py-3 rounded-full shadow-xl hover:bg-gray-800 transition-all duration-300 transform hover:scale-105 text-sm font-medium tracking-wide hidden"
    aria-label={t("hero.show")}
  >
    {t("hero.show")}
  </button>
</BaseLayout>
