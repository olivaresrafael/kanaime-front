---
import BaseLayout from "../layouts/BaseLayout.astro";
import SchemaOrg from "../components/SchemaOrg.astro";
import FormattedDate from "../components/FormattedDate.astro";
import SkeletonImageNatural from "../components/SkeletonImageNatural.astro";
import { useTranslations } from "../i18n/utils";
import { getAllPosts, sortPostsByDate } from "../utils/content";
import { getImageSrc } from "../utils/images";
import { slugify } from "../utils/slugify";
import { SITE_TITLE } from "../consts";

const lang = "es";
const t = useTranslations(lang);

const posts = sortPostsByDate(await getAllPosts());

const tagMap = new Map<string, string>();
posts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    const tagSlug = slugify(tag);
    if (!tagMap.has(tagSlug)) tagMap.set(tagSlug, tag);
  });
});
const allTags = Array.from(tagMap.entries());

const description = `Explora todo el archivo de ${SITE_TITLE}: naturaleza, exploración, cultura, fotografía y perfiles desde Venezuela.`;
---

<BaseLayout
  title={`${t("search.title")} — ${SITE_TITLE}`}
  description={description}
  lang={lang}
>
  <Fragment slot="head">
    <SchemaOrg
      schema={{
        type: "breadcrumb",
        items: [
          { name: t("nav.home"), url: "/" },
          { name: t("search.title"), url: "/search/" },
        ],
      }}
    />
    <script src="/scripts/global-search.js" is:inline></script>
  </Fragment>

  <main class="w-full bg-white">
    <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-16 md:pt-24 pb-8">
      <p class="text-[10px] md:text-xs uppercase tracking-[0.3em] text-gray-400 mb-4">
        {t("tags.explore")}
      </p>
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold leading-none mb-12 font-bebas">
        {t("search.title")}
      </h1>

      <div class="relative mb-12">
        <input
          type="text"
          id="search-input"
          placeholder={t("search.placeholder")}
          class="w-full border-b border-gray-300 py-4 pr-12 text-lg md:text-xl font-light bg-transparent focus:outline-none focus:border-[#A31621] transition-colors font-serif"
        />
        <button
          id="search-btn"
          class="absolute right-0 top-1/2 -translate-y-1/2 text-gray-400 hover:text-[#A31621] transition-colors"
          aria-label={t("nav.search")}
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </div>

      <div class="mb-16">
        <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 mb-6">{t("search.filterByTag")}</p>
        <div class="flex flex-wrap gap-3" id="tag-filters">
          <button
            data-tag=""
            class="px-5 py-2 border text-xs uppercase tracking-wider transition-colors border-[#A31621] text-[#A31621] bg-[#A31621]/5"
          >
            {t("search.all")}
          </button>
          {allTags.map(([slug, display]) => (
            <button
              data-tag={slug}
              class="px-5 py-2 border border-gray-200 text-xs uppercase tracking-wider text-gray-600 hover:border-[#A31621] hover:text-[#A31621] transition-colors"
            >
              {display}
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pb-20 md:pb-32">
      <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 mb-8" id="results-count">
        {posts.length} {posts.length === 1 ? t("search.result") : t("search.results")}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-y-16 md:gap-x-8" id="results-grid">
        {posts.map((post, index) => {
          const imgSrc = getImageSrc(post.data.heroImage);
          const isLarge = index === 0;
          const isOdd = index % 2 !== 0;

          return (
            <article
              class={`search-item ${
                isLarge
                  ? "md:col-span-7"
                  : isOdd
                    ? "md:col-span-5 md:col-start-8"
                    : "md:col-span-5"
              }`}
              data-title={post.data.title.toLowerCase()}
              data-description={post.data.description.toLowerCase()}
              data-author={(post.data.author || "").toLowerCase()}
              data-tags={post.data.tags.map((t) => slugify(t)).join(",")}
            >
              <a href={`/blog/${post.id}/`} class="block group">
                {imgSrc && (
                  <SkeletonImageNatural
                    src={imgSrc}
                    alt={post.data.title}
                    class="mb-5 bg-gray-100"
                    imgClass="w-full h-auto grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105"
                  />
                )}

                <div class="flex items-center gap-3 text-[10px] uppercase tracking-[0.2em] text-gray-400 mb-3">
                  {post.data.author && <span>{post.data.author}</span>}
                  {post.data.author && <span>·</span>}
                  <FormattedDate date={post.data.pubDate} lang={lang} />
                  {post.data.tags[0] && (
                    <>
                      <span>·</span>
                      <span>{post.data.tags[0]}</span>
                    </>
                  )}
                </div>

                <h2
                  class={`font-bold leading-tight group-hover:text-[#A31621] transition-colors ${
                    isLarge ? "text-3xl md:text-4xl" : "text-2xl md:text-3xl"
                  } font-bebas`}
                >
                  {post.data.title}
                </h2>

                <p class="text-sm md:text-base font-light text-gray-500 mt-3 leading-relaxed line-clamp-2 font-serif">
                  {post.data.description}
                </p>
              </a>
            </article>
          );
        })}
      </div>

      <p
        class="text-lg text-gray-400 font-light hidden font-serif"
        id="no-results"
      >
        {t("search.noResults")}
      </p>
    </section>
  </main>
</BaseLayout>
