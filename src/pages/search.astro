---
import { useTranslations } from "../i18n/utils";
const lang = "es";
const t = useTranslations(lang);

import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import SchemaOrg from "../components/SchemaOrg.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import SkeletonImageNatural from "../components/SkeletonImageNatural.astro";
import { slugify } from "../utils/slugify";
import { SITE_TITLE } from "../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Extraer todos los tags únicos
const tagMap = new Map<string, string>();
posts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    const tagSlug = slugify(tag);
    if (!tagMap.has(tagSlug)) {
      tagMap.set(tagSlug, tag);
    }
  });
});

const allTags = Array.from(tagMap.entries());
const description = `Explora todo el archivo de ${SITE_TITLE}: naturaleza, exploración, cultura, fotografía y perfiles desde Venezuela.`;

---
<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={`Buscar — ${SITE_TITLE}`} description={description} lang={lang} />
    <SchemaOrg
      schema={{
        type: "breadcrumb",
        items: [
          { name: "Inicio", url: "/" },
          { name: "Buscar", url: "/search/" },
        ],
      }}
    />
  </head>
  <body>
    <Header lang={lang} />

    <main class="w-full bg-white">
      <!-- Search Header -->
      <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-16 md:pt-24 pb-8">
        <p class="text-[10px] md:text-xs uppercase tracking-[0.3em] text-gray-400 mb-4">
          Explorar el archivo
        </p>
        <h1
          class="text-5xl md:text-7xl lg:text-8xl font-bold leading-none mb-12"
          style="font-family: 'Bebas Neue', sans-serif;"
        >
          Buscar
        </h1>

        <!-- Search Input -->
        <div class="relative mb-12">
          <input
            type="text"
            id="search-input"
            placeholder="Buscar artículos..."
            class="w-full border-b border-gray-300 py-4 pr-12 text-lg md:text-xl font-light bg-transparent focus:outline-none focus:border-[#A31621] transition-colors"
            style="font-family: 'Source Serif 4', serif;"
          />
          <button
            id="search-btn"
            class="absolute right-0 top-1/2 -translate-y-1/2 text-gray-400 hover:text-[#A31621] transition-colors"
            aria-label="Buscar"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
        </div>

        <!-- Popular Tags -->
        <div class="mb-16">
          <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 mb-6">Filtrar por tag</p>
          <div class="flex flex-wrap gap-3" id="tag-filters">
            <button
              data-tag=""
              class="px-5 py-2 border text-xs uppercase tracking-wider transition-colors border-[#A31621] text-[#A31621] bg-[#A31621]/5"
            >
              Todos
            </button>
            {allTags.map(([slug, display]) => (
              <button
                data-tag={slug}
                class="px-5 py-2 border border-gray-200 text-xs uppercase tracking-wider text-gray-600 hover:border-[#A31621] hover:text-[#A31621] transition-colors"
              >
                {display}
              </button>
            ))}
          </div>
        </div>
      </section>

      <!-- Results -->
      <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pb-20 md:pb-32">
        <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 mb-8" id="results-count">
          {posts.length} {posts.length === 1 ? "artículo" : "artículos"}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-y-16 md:gap-x-8" id="results-grid">
          {posts.map((post, index) => {
            const imgSrc = post.data.heroImage && typeof post.data.heroImage === "object"
              ? post.data.heroImage.src
              : post.data.heroImage;

            const isLarge = index === 0;
            const isOdd = index % 2 !== 0;

            return (
              <article
                class={`search-item ${
                  isLarge
                    ? "md:col-span-7"
                    : isOdd
                      ? "md:col-span-5 md:col-start-8"
                      : "md:col-span-5"
                }`}
                data-title={post.data.title.toLowerCase()}
                data-description={post.data.description.toLowerCase()}
                data-author={(post.data.author || "").toLowerCase()}
                data-tags={post.data.tags.map((t) => slugify(t)).join(",")}
              >
                <a href={`/blog/${post.id}/`} class="block group">
                  {imgSrc && (
                    <SkeletonImageNatural
                      src={imgSrc}
                      alt={post.data.title}
                      class="mb-5 bg-gray-100"
                      imgClass="w-full h-auto grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105"
                    />
                  )}

                  <div class="flex items-center gap-3 text-[10px] uppercase tracking-[0.2em] text-gray-400 mb-3">
                    {post.data.author && <span>{post.data.author}</span>}
                    {post.data.author && <span>·</span>}
                    <FormattedDate date={post.data.pubDate} />
                    {post.data.tags[0] && (
                      <>
                        <span>·</span>
                        <span>{post.data.tags[0]}</span>
                      </>
                    )}
                  </div>

                  <h2
                    class={`font-bold leading-tight group-hover:text-[#A31621] transition-colors ${
                      isLarge ? "text-3xl md:text-4xl" : "text-2xl md:text-3xl"
                    }`}
                    style="font-family: 'Bebas Neue', sans-serif;"
                  >
                    {post.data.title}
                  </h2>

                  <p
                    class="text-sm md:text-base font-light text-gray-500 mt-3 leading-relaxed line-clamp-2"
                    style="font-family: 'Source Serif 4', serif;"
                  >
                    {post.data.description}
                  </p>
                </a>
              </article>
            );
          })}
        </div>

        <p
          class="text-lg text-gray-400 font-light hidden"
          id="no-results"
          style="font-family: 'Source Serif 4', serif;"
        >
          No se encuentran resultados.
        </p>
      </section>
    </main>

    <Footer lang={lang} />

    <script is:inline>
      (function() {
        const input = document.getElementById('search-input');
        const btn = document.getElementById('search-btn');
        const countLabel = document.getElementById('results-count');
        const noResults = document.getElementById('no-results');
        const articles = document.querySelectorAll('.search-item');
        const tagButtons = document.querySelectorAll('#tag-filters button');

        let activeTag = '';

        function normalize(str) {
          return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
        }

        function filterPosts() {
          const query = normalize(input.value);
          let visibleCount = 0;

          articles.forEach(function(article) {
            const title = normalize(article.dataset.title || '');
            const desc = normalize(article.dataset.description || '');
            const author = normalize(article.dataset.author || '');
            const tags = article.dataset.tags || '';

            const matchesText = !query || title.includes(query) || desc.includes(query) || author.includes(query);
            const matchesTag = !activeTag || tags.split(',').includes(activeTag);

            if (matchesText && matchesTag) {
              article.style.display = '';
              visibleCount++;
            } else {
              article.style.display = 'none';
            }
          });

          if (countLabel) {
            countLabel.textContent = visibleCount + (visibleCount === 1 ? ' artículo' : ' artículos');
          }

          if (noResults) {
            noResults.classList.toggle('hidden', visibleCount > 0);
          }
        }

        if (input) {
          input.addEventListener('input', filterPosts);
          input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') filterPosts();
          });
        }
        if (btn) {
          btn.addEventListener('click', filterPosts);
        }

        tagButtons.forEach(function(button) {
          button.addEventListener('click', function() {
            activeTag = button.dataset.tag || '';

            tagButtons.forEach(function(b) {
              b.classList.remove('border-[#A31621]', 'text-[#A31621]', 'bg-[#A31621]/5');
              b.classList.add('border-gray-200', 'text-gray-600');
            });
            button.classList.remove('border-gray-200', 'text-gray-600');
            button.classList.add('border-[#A31621]', 'text-[#A31621]', 'bg-[#A31621]/5');

            filterPosts();
          });
        });
      })();
    </script>
  </body>
</html>
