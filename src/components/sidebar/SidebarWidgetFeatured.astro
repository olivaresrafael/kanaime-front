---
// Widget: Artículo destacado
import { useTranslations } from "../../i18n/utils";
import FormattedDate from "../FormattedDate.astro";

interface Post {
  id: string;
  data: {
    title: string;
    description: string;
    pubDate: Date;
    heroImage?: any;
    author?: string;
    tags?: string[];
  };
}

interface Props {
  lang: "es" | "en";
  mode?: "simple" | "detail";
  posts: Post[];
  currentPostId?: string;
}

const { lang, mode = "simple", posts, currentPostId } = Astro.props;
const t = useTranslations(lang);
const basePath = lang === "es" ? "" : "/en";

// Usar el post más reciente que no sea el actual
const featured = posts
  .filter((p) => p.id !== currentPostId)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];

if (!featured) return;

const imgSrc =
  featured.data.heroImage && typeof featured.data.heroImage === "object"
    ? featured.data.heroImage.src
    : featured.data.heroImage;
---

<div>
  <h3
    class="text-sm uppercase tracking-[0.25em] text-gray-400 mb-6"
    style="font-family: 'Bebas Neue', sans-serif;"
  >
    {t("sidebar.featured")}
  </h3>

  <a href={`${basePath}/blog/${featured.id}/`} class="group block">
    {mode === "detail" && imgSrc && (
      <div class="overflow-hidden mb-3 bg-gray-100">
        <img
          src={imgSrc}
          alt={featured.data.title}
          class="w-full h-32 object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
          loading="lazy"
        />
      </div>
    )}
    <h4
      class="text-base font-bold leading-snug group-hover:text-[#A31621] transition-colors mb-2"
      style="font-family: 'Bebas Neue', sans-serif;"
    >
      {featured.data.title}
    </h4>
    <p
      class="text-sm font-light leading-relaxed text-gray-600 line-clamp-3"
      style="font-family: 'Source Serif 4', serif;"
    >
      {featured.data.description}
    </p>
    {mode === "detail" && (
      <div class="mt-2 flex items-center gap-2 text-[10px] uppercase tracking-wider text-gray-400">
        {featured.data.author && <span>{featured.data.author}</span>}
        <span>|</span>
        <FormattedDate date={featured.data.pubDate} />
      </div>
    )}
  </a>
</div>
