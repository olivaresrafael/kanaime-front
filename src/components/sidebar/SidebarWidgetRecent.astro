---
// Widget: Artículos recientes
import { useTranslations } from "../../i18n/utils";
import FormattedDate from "../FormattedDate.astro";
import { slugify } from "../../utils/slugify";

interface Post {
  id: string;
  data: {
    title: string;
    description: string;
    pubDate: Date;
    heroImage?: any;
    tags?: string[];
  };
}

interface Props {
  lang: "es" | "en";
  mode?: "simple" | "detail";
  posts: Post[];
  currentPostId?: string;
  limit?: number;
}

const { lang, mode = "simple", posts, currentPostId, limit = 5 } = Astro.props;
const t = useTranslations(lang);
const basePath = lang === "es" ? "" : "/en";

const recentPosts = posts
  .filter((p) => p.id !== currentPostId)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, limit);
---

<div>
  <h3
    class="text-sm uppercase tracking-[0.25em] text-gray-400 mb-6"
    style="font-family: 'Bebas Neue', sans-serif;"
  >
    {t("sidebar.recent")}
  </h3>

  <div class="space-y-5">
    {
      recentPosts.map((post) => {
        const imgSrc =
          post.data.heroImage && typeof post.data.heroImage === "object"
            ? post.data.heroImage.src
            : post.data.heroImage;
        const primaryTag = post.data.tags?.[0];
        return (
          <a
            href={`${basePath}/blog/${post.id}/`}
            class="group block"
          >
            {mode === "detail" && imgSrc && (
              <div class="overflow-hidden mb-2 bg-gray-100">
                <img
                  src={imgSrc}
                  alt={post.data.title}
                  class="w-full h-24 object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
                  loading="lazy"
                />
              </div>
            )}
            <h4
              class="text-sm font-light leading-snug group-hover:text-[#A31621] transition-colors"
              style="font-family: 'Source Serif 4', serif;"
            >
              {post.data.title}
            </h4>
            {mode === "detail" && (
              <div class="mt-1 flex items-center gap-2 text-[10px] uppercase tracking-wider text-gray-400">
                <FormattedDate date={post.data.pubDate} />
                {primaryTag && (
                  <>
                    <span>|</span>
                    <span>{primaryTag}</span>
                  </>
                )}
              </div>
            )}
          </a>
        );
      })
    }
  </div>
</div>
