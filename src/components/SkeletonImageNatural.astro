---
// SkeletonImageNatural: wrapper de SkeletonImage en modo natural (h:auto).
import SkeletonImage from "./SkeletonImage.astro";

interface Props {
  src: string;
  alt?: string;
  class?: string;
  imgClass?: string;
  minHeight?: string;
}

const {
  src,
  alt = "",
  class: className = "",
  imgClass = "",
  minHeight = "200px",
} = Astro.props;
---

<SkeletonImage
  src={src}
  alt={alt}
  class={className}
  imgClass={imgClass}
  aspect="natural"
  minHeight={minHeight}
/>
