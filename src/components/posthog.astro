// y variables de entorno en Cloudflare runtime.
---

<script>
  import posthog from 'posthog-js';

  const PUBLIC_POSTHOG_PROJECT_TOKEN = "phc_n3rVbj7vReMKh3zJWPspoxzrRn4gJ54GsVWAFxPqZfbc";
  const PUBLIC_POSTHOG_HOST = "https://us.i.posthog.com";

  if (typeof window !== "undefined" && PUBLIC_POSTHOG_PROJECT_TOKEN) {
    posthog.init(PUBLIC_POSTHOG_PROJECT_TOKEN, {
      api_host: PUBLIC_POSTHOG_HOST,
      defaults: "2026-01-30",
      loaded: function (posthog) {
        if (posthog.config.debug) console.log("PostHog loaded");
      },
    });
