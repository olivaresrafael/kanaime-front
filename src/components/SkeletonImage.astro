---
// SkeletonImage: envuelve una imagen con un estado de carga skeleton
// Uso: <SkeletonImage src="..." alt="..." class="..." aspect="16/9" />
interface Props {
  src: string;
  alt?: string;
  class?: string;
  aspect?: string; // ej: "16/9", "4/3", "3/4"
  rounded?: boolean;
}

const { src, alt = "", class: className = "", aspect = "16/9", rounded = false } = Astro.props;
const uniqueId = Math.random().toString(36).substring(2, 9);
---

<div
  class={`skeleton-wrap skeleton-${uniqueId} ${rounded ? 'rounded-lg overflow-hidden' : ''} ${className}`}
  data-aspect={aspect}
>
  <div class="skeleton-pulse"></div>
  <img
    src={src}
    alt={alt}
    class="skeleton-img"
    loading="lazy"
    onload={`document.querySelector('.skeleton-${uniqueId}').classList.add('loaded')`}
    onerror={`document.querySelector('.skeleton-${uniqueId}').classList.add('error')`}
  />
</div>

<style>
  .skeleton-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #f3f4f6;
  }
  .skeleton-wrap[data-aspect="16/9"] { aspect-ratio: 16/9; }
  .skeleton-wrap[data-aspect="4/3"] { aspect-ratio: 4/3; }
  .skeleton-wrap[data-aspect="3/4"] { aspect-ratio: 3/4; }
  .skeleton-wrap[data-aspect="21/9"] { aspect-ratio: 21/9; }
  .skeleton-wrap[data-aspect="1/1"] { aspect-ratio: 1/1; }
  .skeleton-wrap[data-aspect="auto"] { aspect-ratio: auto; }

  .skeleton-pulse {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #f3f4f6 0%,
      #e5e7eb 50%,
      #f3f4f6 100%
    );
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.5s infinite;
    z-index: 1;
  }

  .skeleton-img {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .skeleton-wrap.loaded .skeleton-img,
  .skeleton-wrap.error .skeleton-img {
    opacity: 1;
  }
  .skeleton-wrap.loaded .skeleton-pulse,
  .skeleton-wrap.error .skeleton-pulse {
    opacity: 0;
    animation: none;
    transition: opacity 0.3s ease;
  }

  @keyframes skeleton-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>
