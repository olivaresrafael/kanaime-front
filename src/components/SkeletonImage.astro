---
// SkeletonImage: envuelve una imagen con estado de carga skeleton.
// aspect="natural" usa h:auto; cualquier otro valor fija aspect-ratio.
interface Props {
  src: string;
  alt?: string;
  class?: string;
  imgClass?: string;
  aspect?: string; // ej: "16/9", "4/3", "3/4", "natural"
  rounded?: boolean;
  minHeight?: string; // solo para modo natural
}

const {
  src,
  alt = "",
  class: className = "",
  imgClass = "",
  aspect = "16/9",
  rounded = false,
  minHeight = "200px",
} = Astro.props;

const isNatural = aspect === "natural";
const uniqueId = Math.random().toString(36).substring(2, 9);
const wrapClass = isNatural ? `skeleton-natural-wrap skeleton-${uniqueId}` : `skeleton-wrap skeleton-${uniqueId}`;
---

<div
  class={`${wrapClass} ${rounded ? "rounded-lg overflow-hidden" : ""} ${className}`}
  data-aspect={isNatural ? undefined : aspect}
  style={isNatural ? `min-height: ${minHeight};` : undefined}
>
  <div class={isNatural ? "skeleton-natural-pulse" : "skeleton-pulse"}></div>
  <img
    src={src}
    alt={alt}
    class={isNatural ? `skeleton-natural-img ${imgClass}` : `skeleton-img ${imgClass}`}
    loading="lazy"
    onload={`document.querySelector('.skeleton-${uniqueId}').classList.add('loaded')`}
    onerror={`document.querySelector('.skeleton-${uniqueId}').classList.add('error')`}
  />
</div>

<style>
  .skeleton-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #f3f4f6;
  }
  .skeleton-wrap[data-aspect="16/9"] { aspect-ratio: 16/9; }
  .skeleton-wrap[data-aspect="4/3"] { aspect-ratio: 4/3; }
  .skeleton-wrap[data-aspect="3/4"] { aspect-ratio: 3/4; }
  .skeleton-wrap[data-aspect="21/9"] { aspect-ratio: 21/9; }
  .skeleton-wrap[data-aspect="1/1"] { aspect-ratio: 1/1; }

  .skeleton-pulse {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #f3f4f6 0%, #e5e7eb 50%, #f3f4f6 100%);
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.5s infinite;
    z-index: 1;
  }

  .skeleton-img {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .skeleton-wrap.loaded .skeleton-img,
  .skeleton-wrap.error .skeleton-img {
    opacity: 1;
  }
  .skeleton-wrap.loaded .skeleton-pulse,
  .skeleton-wrap.error .skeleton-pulse {
    opacity: 0;
    animation: none;
    transition: opacity 0.3s ease;
  }

  /* Natural variant */
  .skeleton-natural-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #f3f4f6;
  }
  .skeleton-natural-pulse {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #f3f4f6 0%, #e5e7eb 50%, #f3f4f6 100%);
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.5s infinite;
    z-index: 1;
  }
  .skeleton-natural-img {
    position: relative;
    z-index: 2;
    width: 100%;
    height: auto;
    opacity: 0;
    transition: opacity 0.4s ease;
    display: block;
  }
  .skeleton-natural-wrap.loaded .skeleton-natural-img,
  .skeleton-natural-wrap.error .skeleton-natural-img {
    opacity: 1;
  }
  .skeleton-natural-wrap.loaded .skeleton-natural-pulse,
  .skeleton-natural-wrap.error .skeleton-natural-pulse {
    opacity: 0;
    animation: none;
    transition: opacity 0.3s ease;
  }

  @keyframes skeleton-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>
