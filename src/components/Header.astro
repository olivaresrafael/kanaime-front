---
import HeaderLink from "./HeaderLink.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { SITE_TITLE } from "../consts";
import { useTranslations } from "../i18n/utils";
import Divider from "./Divider.astro";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header>
  <nav>
    <h2 class="text-8xl font-bold text-right pt-10 pb-6">
      <a href={`/${lang}/`}>{SITE_TITLE}</a>
    </h2>
    <div class="internal-links">
      <HeaderLink
        href={`/${lang}/tags/${lang === "es" ? "naturaleza" : "nature"}/`}
        >{t("nav.nature")}</HeaderLink
      >
      <HeaderLink
        href={`/${lang}/tags/${lang === "es" ? "exploracion" : "exploration"}/`}
        >{t("nav.exploration")}</HeaderLink
      >
      <HeaderLink
        href={`/${lang}/tags/${lang === "es" ? "cultura" : "culture"}/`}
        >{t("nav.culture")}</HeaderLink
      >
      <HeaderLink
        href={`/${lang}/tags/${lang === "es" ? "fotografia" : "photography"}/`}
        >{t("nav.photography")}</HeaderLink
      >
      <HeaderLink
        href={`/${lang}/tags/${lang === "es" ? "perfiles" : "profiles"}/`}
        >{t("nav.profiles")}</HeaderLink
      >
    </div>
    <div class="header-right">
      <div class="language-switcher-wrapper pt-4">
        <LanguageSwitcher lang={lang} />
      </div>
      <div class="internal-links">
        <HeaderLink href={`/${lang}/`}>{t("nav.home")}</HeaderLink>
        <HeaderLink href={`/${lang}/autores/`}>{t("nav.authors")}</HeaderLink>
        <HeaderLink href={`/${lang}/sponsors/`}>{t("nav.sponsors")}</HeaderLink>
        <a
          href={`/${lang}/search/`}
          aria-label={t("nav.search")}
          class="search-link"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>
      </div>
    </div>
  </nav>
  <Divider className="mx-[50px]" />
</header>

<style>
  header {
    margin: 0;
    background: white;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
    padding-left: 0 !important;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 5em;
    margin: auto;
  }
  nav a {
    padding: 0.5em;
    color: var(--black);
    border-bottom: 2px solid transparent;
    text-decoration: none;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
  }
  .search-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5em;
    color: var(--black);
    border-bottom: 2px solid transparent;
    transition: color 0.2s;
  }
  .search-link:hover {
    color: var(--accent);
  }
  .header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .language-switcher-wrapper {
    margin-top: -1.25rem;
  }
  .social-links,
  .social-links a {
    display: flex;
  }
  @media (max-width: 720px) {
    .social-links {
      display: none;
    }
    nav {
      flex-direction: column;
      padding: 0 1em;
    }
    h2 {
      font-size: 4rem !important;
      text-align: center !important;
      padding-top: 1rem !important;
      padding-bottom: 0.5rem !important;
    }
    .internal-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }
    .header-right {
      align-items: center;
    }
  }
</style>
