---
import { useTranslations } from "../i18n/utils";
import { SITE_TITLE } from "../consts";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="border-t border-gray-200 mt-20">
  <div class="container mx-auto px-4 md:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Columna 1: Links rápidos -->
      <div>
        <h3 class="text-sm uppercase tracking-widest text-gray-400 mb-6 bebas-neue-regular">{t("footer.navigation")}</h3>
        <ul class="space-y-3">
          <li><a href={`/${lang}/`} class="text-lg hover:text-gray-600 transition-colors source-serif-4-font">{t("nav.home")}</a></li>
          <li><a href={`/${lang}/about/`} class="text-lg hover:text-gray-600 transition-colors source-serif-4-font">{t("nav.about")}</a></li>
          <li><a href={`/${lang}/sponsors/`} class="text-lg hover:text-gray-600 transition-colors source-serif-4-font">{t("nav.sponsors")}</a></li>
          <li><a href="/rss.xml" class="text-lg hover:text-gray-600 transition-colors source-serif-4-font">RSS</a></li>
        </ul>
      </div>

      <!-- Columna 2: Logo centrado -->
      <div class="flex flex-col items-center justify-center">
        <a href={`/${lang}/`} class="text-6xl md:text-7xl font-bold bebas-neue-regular mb-4">{SITE_TITLE}</a>
        <p class="text-center text-gray-500 text-sm max-w-xs source-serif-4-font">
          {t("footer.tagline")}
        </p>
      </div>

      <!-- Columna 3: Categorías y contacto -->
      <div class="md:text-right">
        <h3 class="text-sm uppercase tracking-widest text-gray-400 mb-6 bebas-neue-regular">{t("footer.categories")}</h3>
        <ul class="space-y-3">
          <li><a href={`/${lang}/tags/${lang === "es" ? "naturaleza" : "nature"}/`} class="text-lg hover:text-gray-600 transition-colors source-serif-4-font">{t("nav.nature")}</a></li>
          <li><a href={`/${lang}/tags/${lang === "es" ? "exploracion" : "exploration"}/`} class="text-lg hover:text-gray-600 transition-colors source-serif-4-font">{t("nav.exploration")}</a></li>
          <li><a href={`/${lang}/tags/${lang === "es" ? "cultura" : "culture"}/`} class="text-lg hover:text-gray-600 transition-colors source-serif-4-font">{t("nav.culture")}</a></li>
          <li><a href={`/${lang}/tags/${lang === "es" ? "perfiles" : "profiles"}/`} class="text-lg hover:text-gray-600 transition-colors source-serif-4-font">{t("nav.profiles")}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-gray-100 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-400 source-serif-4-font">
        &copy; {new Date().getFullYear()} {SITE_TITLE}. Todos los derechos reservados.
      </p>
      <p class="text-sm text-gray-400 source-serif-4-font">
        Hecho con pasión en Venezuela.
      </p>
    </div>
  </div>
</footer>
