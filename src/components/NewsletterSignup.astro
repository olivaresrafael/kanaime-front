---
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="my-16 md:my-24">
  <div class="bg-[#1a1a1a] p-8 md:p-12 lg:p-16 text-center">
    <h3
      class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4 font-bebas"
    >
      {t("newsletter.title")}
    </h3>
    <p
      class="text-base md:text-lg font-light text-white/70 max-w-xl mx-auto mb-8 leading-relaxed font-serif"
    >
      {t("newsletter.subtitle")}
    </p>

    <form
      id="newsletter-form"
      class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto"
      onsubmit="return false;"
    >
      <input
        type="email"
        id="newsletter-email"
        name="email"
        required
        placeholder={t("newsletter.placeholder")}
        class="flex-1 px-5 py-3 bg-white/10 border border-white/20 text-white placeholder:text-white/40 text-sm tracking-wide focus:outline-none focus:border-[#A31621] transition-colors"
      />
      <button
        type="submit"
        id="newsletter-btn"
        class="px-8 py-3 bg-[#A31621] text-white text-xs uppercase tracking-[0.2em] font-medium hover:bg-[#8a121c] transition-colors shrink-0 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        {t("newsletter.button")}
      </button>
    </form>

    <p
      id="newsletter-success"
      class="mt-4 text-sm text-white/60 hidden font-serif"
    >
      {t("newsletter.success")}
    </p>

    <p
      id="newsletter-error"
      class="mt-4 text-sm text-red-400 hidden font-serif"
    >
      {
        lang === "es"
          ? "Error. Intenta de nuevo más tarde."
          : "Error. Please try again later."
      }
    </p>
  </div>
</div>

<script src="/scripts/newsletter.js" is:inline></script>
