---
// Layout de dos columnas: texto a la izquierda, imagen a la derecha
// Uso en MDX:
// <TwoColumn
//   image="../../assets/blog-placeholder-3.jpg"
//   caption="Pie de foto opcional"
//   reverse
// >
//   Texto del párrafo aquí...
// </TwoColumn>
interface Props {
  image: string;
  caption?: string;
  reverse?: boolean;
  class?: string;
}
const { image, caption, reverse = false, class: className = "" } = Astro.props;
---

<div
  class={`grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 my-12 md:my-20 items-center ${className}`}
>
  <div class={`${reverse ? 'md:order-2' : 'md:order-1'}`}>
    <div class="text-xl md:text-2xl font-light leading-relaxed" style="font-family: 'Source Serif 4', serif;">
      <slot />
    </div>
  </div>
  <figure class={`${reverse ? 'md:order-1' : 'md:order-2'} m-0`}>
    <img
      src={image}
      alt={caption || "Imagen del artículo"}
      class="w-full h-auto object-cover"
      loading="lazy"
    />
    {caption && (
      <figcaption class="mt-3 text-xs uppercase tracking-widest text-gray-400 text-center">
        {caption}
      </figcaption>
    )}
  </figure>
</div>
