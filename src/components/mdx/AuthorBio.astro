---
// Bio del autor al final del artículo
import { getAuthors } from "../../utils/content";
import { getImageSrc } from "../../utils/images";
import { useTranslations } from "../../i18n/utils";

interface Props {
  authorName: string;
  lang?: "es" | "en";
}

const { authorName, lang = "es" } = Astro.props;
const t = useTranslations(lang);
const basePath = lang === "es" ? "" : "/en";

const allAuthors = await getAuthors();
const author = allAuthors.find(
  (a) => a.data.name.toLowerCase() === (authorName || "").toLowerCase()
);

const authorPhotoSrc = getImageSrc(author?.data.photo);
const displayName = author?.data.name || authorName || "Kanaimé Editorial";
const role = author?.data.role || (lang === "es" ? "Autor" : "Author");
const bio = author?.data.bio || "";
const authorId = author?.id;
---

<aside class="mt-20 md:mt-28 pt-12 border-t border-gray-200">
  <div class="flex flex-col md:flex-row items-start gap-8 md:gap-12">
    {authorPhotoSrc && (
      <div class="shrink-0">
        <img
          src={authorPhotoSrc}
          alt={displayName}
          class="w-24 h-24 md:w-32 md:h-32 object-cover grayscale"
          loading="lazy"
        />
      </div>
    )}
    <div class="flex-1">
      <p class="text-xs uppercase tracking-[0.2em] text-gray-400 mb-2">{t("post.writtenBy")}</p>
      <h3 class="text-2xl md:text-3xl font-bold mb-3 font-bebas">
        {authorId ? (
          <a href={`${basePath}/autor/${authorId}/`} class="hover:text-[#A31621] transition-colors">
            {displayName}
          </a>
        ) : (
          <span>{displayName}</span>
        )}
      </h3>
      {role && <p class="text-sm uppercase tracking-wider text-gray-400 mb-4">{role}</p>}
      {bio && (
        <p class="text-lg font-light leading-relaxed text-gray-700 font-serif">
          {bio}
        </p>
      )}
      {authorId && (
        <div class="mt-6 flex gap-6 text-xs uppercase tracking-widest">
          <a href={`${basePath}/autor/${authorId}/`} class="text-gray-400 hover:text-[#A31621] transition-colors">
            {t("post.viewProfile")}
          </a>
          {author?.data.social?.twitter && (
            <a href={author.data.social.twitter} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-[#A31621] transition-colors">
              {t("post.follow")}
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</aside>
