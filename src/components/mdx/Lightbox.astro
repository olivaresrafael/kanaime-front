---
// Lightbox / galería para imágenes del artículo
// Se incluye una vez en el layout BlogPost.astro
const label = "Vista ampliada";
---

<div
  id="article-lightbox"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/95 backdrop-blur-sm cursor-zoom-out"
  role="dialog"
  aria-modal="true"
  aria-label={label}
>
  <button
    id="lightbox-close"
    class="absolute top-6 right-6 text-white/60 hover:text-white transition-colors z-10"
    aria-label="Cerrar"
  >
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <div class="max-w-[90vw] max-h-[90vh] flex flex-col items-center">
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-[78vh] object-contain select-none"
    />
    <div class="mt-6 text-center max-w-2xl px-4">
      <p id="lightbox-caption" class="text-sm uppercase tracking-[0.2em] text-white/70"></p>
      <p id="lightbox-credit" class="text-xs uppercase tracking-wider text-white/40 mt-2"></p>
    </div>
  </div>
</div>

<script src="/scripts/lightbox.js" is:inline></script>
