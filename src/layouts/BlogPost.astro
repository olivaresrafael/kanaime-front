---
import { type CollectionEntry, getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import SchemaOrg from "../components/SchemaOrg.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import ReadingTime from "../components/ReadingTime.astro";
import AuthorBio from "../components/mdx/AuthorBio.astro";
import Lightbox from "../components/mdx/Lightbox.astro";
import Sidebar from "../components/sidebar/Sidebar.astro";
import { useTranslations } from "../i18n/utils";
import { slugify } from "../utils/slugify";

type Props = CollectionEntry<"blog">["data"] & {
  slug?: string;
  tags?: string[];
  canonicalUrl?: string;
  readingTimeMinutes?: number;
  lang?: "es" | "en";
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  coverImage,
  author,
  slug,
  tags,
  canonicalUrl: customCanonicalUrl,
  readingTimeMinutes,
  lang: propLang,
} = Astro.props;

const lang = propLang || (Astro.url.pathname.startsWith("/en/") ? "en" : "es");
const t = useTranslations(lang);

// coverImage = hero del post individual; heroImage = portada para listados/home
const coverSrc = coverImage && typeof coverImage === "object" ? coverImage.src : coverImage;
const listHeroSrc = heroImage && typeof heroImage === "object" ? heroImage.src : heroImage;
const heroSrc = coverSrc || listHeroSrc;
const canonicalUrl =
  customCanonicalUrl ||
  (slug ? new URL(`/${lang}/blog/${slug}/`, Astro.site).toString() : new URL(Astro.url.pathname, Astro.site).toString());
const breadcrumbUrl = customCanonicalUrl || (slug ? `/${lang}/blog/${slug}/` : Astro.url.pathname);
const primaryTag = tags?.[0];

const allAuthors = await getCollection("authors");
const authorEntry = author
  ? allAuthors.find((a) => a.data.name.toLowerCase() === author.toLowerCase())
  : undefined;
const authorProfileUrl = authorEntry ? `/${lang}/autor/${authorEntry.id}/` : undefined;

// Posts del mismo idioma para el sidebar
const allPosts = await getCollection("blog");
const langPosts = allPosts.filter((p) => p.data.lang === lang);
---

<html lang={lang}>
  <head>
    <BaseHead
      title={`${title} — Kanaimé`}
      description={description}
      image={coverImage || heroImage}
      ogType="article"
      article={{
        publishedTime: pubDate,
        modifiedTime: updatedDate,
        author: author || "Kanaimé Editorial",
        tags: tags || [],
      }}
      lang={lang}
    />
    <SchemaOrg
      schema={{
        type: "article",
        headline: title,
        description: description,
        image: heroSrc
          ? new URL(heroSrc, Astro.site).toString()
          : new URL("/favicon.svg", Astro.site).toString(),
        datePublished: pubDate.toISOString(),
        ...(updatedDate && { dateModified: updatedDate.toISOString() }),
        author: author || "Kanaimé Editorial",
        url: canonicalUrl,
        tags: tags || [],
      }}
    />
    <SchemaOrg
      schema={{
        type: "breadcrumb",
        items: [
          { name: t("nav.home"), url: `/${lang}/` },
          { name: title, url: breadcrumbUrl },
        ],
      }}
    />
    <style>
      .article-body :global(p) {
        margin-bottom: 1.8em;
        line-height: 1.75;
      }
      .article-body :global(h2) {
        font-family: "Bebas Neue", sans-serif;
        font-size: 2.5rem;
        margin-top: 2em;
        margin-bottom: 0.6em;
        letter-spacing: 0.02em;
        line-height: 1.1;
      }
      .article-body :global(h3) {
        font-family: "Bebas Neue", sans-serif;
        font-size: 1.75rem;
        margin-top: 1.8em;
        margin-bottom: 0.5em;
        letter-spacing: 0.02em;
        line-height: 1.15;
      }
      .article-body :global(ul),
      .article-body :global(ol) {
        margin-bottom: 1.8em;
        padding-left: 1.5em;
      }
      .article-body :global(li) {
        margin-bottom: 0.5em;
        line-height: 1.7;
      }
      .article-body :global(blockquote) {
        margin: 2em 0;
        padding-left: 1.5em;
        border-left: 3px solid #A31621;
        font-style: italic;
      }
      .article-body :global(a) {
        text-decoration: underline;
        text-underline-offset: 3px;
        transition: color 0.2s;
      }
      .article-body :global(a:hover) {
        color: #A31621;
      }
      .article-body :global(img) {
        width: 100%;
        height: auto;
        margin: 2em 0;
      }
      .article-body :global(figure) {
        margin: 2em 0;
      }
      .article-body :global(figcaption) {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: #9ca3af;
        text-align: center;
        margin-top: 0.75rem;
      }
      .skeleton-hero-pulse {
        background: linear-gradient(90deg, #1f0507 0%, #3d0a0e 50%, #1f0507 100%);
        background-size: 200% 100%;
        animation: skeleton-shimmer 1.5s infinite;
        z-index: 1;
      }
      .skeleton-hero-img {
        position: relative;
        z-index: 2;
        opacity: 0;
        transition: opacity 0.4s ease;
      }
      .skeleton-hero.loaded .skeleton-hero-img,
      .skeleton-hero.error .skeleton-hero-img {
        opacity: 1;
      }
      .skeleton-hero.loaded .skeleton-hero-pulse,
      .skeleton-hero.error .skeleton-hero-pulse {
        opacity: 0;
        animation: none;
        transition: opacity 0.3s ease;
      }
      @keyframes skeleton-shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }
    </style>
  </head>

  <body>
    <Header lang={lang} />

    <!-- HERO FULL-WIDTH: aspect-ratio fijo para que la imagen y el gradiente coincidan exactamente -->
    <header class="relative w-full aspect-[4/3] sm:aspect-[16/9] lg:aspect-[21/9] flex items-end overflow-hidden">
      {heroSrc && (
        <div class="absolute inset-0 z-0 skeleton-hero">
          <img
            src={heroSrc}
            alt={title}
            class="w-full h-full object-cover skeleton-hero-img"
            loading="lazy"
            onload="this.parentElement.classList.add('loaded')"
            onerror="this.parentElement.classList.add('error')"
            itemprop="image"
          />
          <div class="skeleton-hero-pulse absolute inset-0"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent" />
        </div>
      )}

      <div class="relative z-10 w-full px-6 md:px-12 lg:px-20 pb-12 md:pb-20 pt-32">
        <div class="max-w-5xl">
          {primaryTag && (
            <a
              href={`/${lang}/tags/${slugify(primaryTag)}/`}
              class="inline-block text-[10px] md:text-xs uppercase tracking-[0.3em] text-white/70 mb-4 hover:text-white transition-colors"
            >
              {primaryTag}
            </a>
          )}

          <h1
            class="text-4xl md:text-6xl lg:text-7xl font-bold text-white leading-[0.95] mb-6"
            style="font-family: 'Bebas Neue', sans-serif;"
            itemprop="headline"
          >
            {title}
          </h1>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs md:text-sm text-white/80">
            <span itemprop="author" itemscope itemtype="https://schema.org/Person">
              {authorProfileUrl ? (
                <a href={authorProfileUrl} class="hover:text-white transition-colors" itemprop="name">
                  {author}
                </a>
              ) : (
                <span itemprop="name">{author || "Kanaimé Editorial"}</span>
              )}
            </span>
            <span class="hidden md:inline text-white/40">|</span>
            <time datetime={pubDate.toISOString()} itemprop="datePublished">
              <FormattedDate date={pubDate} />
            </time>
            {updatedDate && (
              <>
                <span class="hidden md:inline text-white/40">|</span>
                <time datetime={updatedDate.toISOString()} itemprop="dateModified">
                  Actualizado: <FormattedDate date={updatedDate} />
                </time>
              </>
            )}
            {typeof readingTimeMinutes === "number" && (
              <>
                <span class="hidden md:inline text-white/40">|</span>
                <span class="text-xs uppercase tracking-[0.2em] text-white/70">{readingTimeMinutes} min de lectura</span>
              </>
            )}
          </div>
        </div>
      </div>
    </header>

    <!-- ARTICLE BODY -->
    <main class="w-full bg-white">
      <div class="max-w-[80rem] mx-auto px-6 md:px-8 lg:px-12 py-12 md:py-20">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-12 lg:gap-16">
          <!-- Columna principal: artículo -->
          <article itemscope itemtype="https://schema.org/Article">
            <!-- Lead / Description -->
            <p
              class="text-xl md:text-2xl font-light leading-relaxed text-gray-700 mb-12 md:mb-16"
              style="font-family: 'Source Serif 4', serif;"
              itemprop="description"
            >
              {description}
            </p>

            <div class="article-body text-lg md:text-xl font-light text-gray-800" itemprop="articleBody">
              <slot />
            </div>

            <!-- Tags -->
            {tags && tags.length > 0 && (
              <div class="mt-16 pt-8 border-t border-gray-100">
                <p class="text-xs uppercase tracking-[0.2em] text-gray-400 mb-4">Etiquetas</p>
                <div class="flex flex-wrap gap-3">
                  {tags.map((tag) => (
                    <a
                      href={`/${lang}/tags/${slugify(tag)}/`}
                      class="px-4 py-2 border border-gray-200 text-xs uppercase tracking-wider text-gray-600 hover:border-[#A31621] hover:text-[#A31621] transition-colors"
                    >
                      {tag}
                    </a>
                  ))}
                </div>
              </div>
            )}

            <!-- Author Bio -->
            <AuthorBio authorName={author || "Kanaimé Editorial"} lang={lang} />
          </article>

          <Sidebar
            lang={lang}
            mode="detail"
            widgets={["authors", "related", "recent", "tags", "featured", "random", "archive"]}
            posts={langPosts}
            currentPostId={slug}
            currentTags={tags}
          />
        </div>
      </div>
    </main>

    <Footer lang={lang} />
    <Lightbox />
  </body>
</html>
