# MailerLite API Configuration
# Get your API key from: https://dashboard.mailerlite.com/integrations/api
MAILERLITE_API_KEY=your_mailerlite_api_key_here

# Optional: MailerLite Group ID to auto-add subscribers to a specific group
# Find your group ID in the MailerLite dashboard under Subscribers > Groups
MAILERLITE_GROUP_ID=your_group_id_here
